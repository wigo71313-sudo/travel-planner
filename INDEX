  <!-- Firebase 11.6.1 SDK 模組與核心腳本 -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, doc, setDoc, getDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    // 全局變數綁定到 window 以供內聯 HTML onclick 調用
    window.appState = {
      appId: typeof __app_id !== 'undefined' ? __app_id : 'travel-planner-default',
      roomId: 'GLOBAL_ROOM',
      user: null,
      userName: localStorage.getItem('travel_user_name') || ('旅伴_' + Math.floor(1000 + Math.random() * 9000)),
      userColor: localStorage.getItem('travel_user_color') || getRandomColor(),
      trips: [],
      currentTripId: null,
      currentSelectedDay: 1,
      editingTripId: null,
      unsubscribeDoc: null
    };

    let db, auth;

    // 預設範例行程
    const DEFAULT_TRIPS = [
      {
        id: 'trip_1',
        title: '東京櫻花季 5 天自由行',
        startDate: '2027-03-25',
        endDate: '2027-03-29',
        budget: 50000,
        imageUrl: 'https://images.unsplash.com/photo-1503899036084-c55cdd92da26?auto=format&fit=crop&w=800&q=80',
        flights: [
          {
            id: 'f1',
            type: '去程',
            airline: '星宇航空',
            flightNo: 'JX800',
            pnr: 'K9X82P',
            depAirport: '台北桃園 TPE',
            depTime: '2027-03-25T08:30',
            arrAirport: '東京成田 NRT',
            arrTime: '2027-03-25T12:45',
            terminal: 'T1 Gate B6',
            cost: 14500,
            notes: '含托運行李 23kg，提前 2.5 小時報到',
            updatedBy: '系統預設'
          }
        ],
        spots: [
          { id: 's1', day: 1, time: '14:00', name: '抵達飯店 Check-in', category: '住宿', cost: 12000, location: 'Shinjuku Prince Hotel', url: 'https://www.princehotels.co.jp/shinjuku/', image: 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80', notes: '新宿站東口步行 5 分鐘', updatedBy: '系統預設' },
          { id: 's2', day: 1, time: '16:00', name: '新宿御苑賞櫻', category: '景點', cost: 500, location: 'Shinjuku Gyoen', url: 'https://www.env.go.jp/garden/shinjukugyoen/', image: 'https://images.unsplash.com/photo-1522383225653-ed111181a951?auto=format&fit=crop&w=800&q=80', notes: '門票 500 日圓，欣賞滿開櫻花', updatedBy: '系統預設' },
          { id: 's3', day: 1, time: '18:30', name: '敘敘苑燒肉晚餐', category: '美食', cost: 3200, location: 'Jojoen Shinjuku', url: 'https://www.jojoen.co.jp/', image: 'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80', notes: '已預約高樓層景觀席位', updatedBy: '系統預設' }
        ],
        checklist: [
          { id: 'c1', category: '證件檔案', text: '護照 (效期6個月以上)', checked: true },
          { id: 'c2', category: '證件檔案', text: 'Visit Japan Web QR Code', checked: true },
          { id: 'c3', category: '3C電子', text: '日規轉接頭 & 行動電源', checked: false }
        ]
      }
    ];

    // 初始化 Firebase
    async function initFirebase() {
      try {
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
          apiKey: "demo-api-key",
          authDomain: "demo-app.firebaseapp.com",
          projectId: "demo-app",
          storageBucket: "demo-app.appspot.com",
          messagingSenderId: "123456789",
          appId: "1:123456789:web:abcdef"
        };

        const app = initializeApp(firebaseConfig);
        db = getFirestore(app);
        auth = getAuth(app);

        // 登入驗證
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }

        window.appState.user = auth.currentUser;

        // 取得 URL 房間代碼或生成預設值
        const urlParams = new URLSearchParams(window.location.search);
        let roomParam = urlParams.get('room');
        if (!roomParam) {
          roomParam = 'TRIP' + Math.floor(1000 + Math.random() * 9000);
          const newUrl = window.location.pathname + '?room=' + roomParam;
          window.history.replaceState({ path: newUrl }, '', newUrl);
        }
        
        switchRoom(roomParam.toUpperCase());
        updateUserDisplay();

      } catch (err) {
        console.error("Firebase 初始化失敗:", err);
      }
    }

    // 監聽/訂閱指定房間 Document
    function switchRoom(newRoomId) {
      if (window.appState.unsubscribeDoc) {
        window.appState.unsubscribeDoc();
      }

      window.appState.roomId = newRoomId;
      document.getElementById('displayRoomCode').textContent = newRoomId;
      document.getElementById('displayRoomCodeMobile').textContent = newRoomId;

      // Firestore 路徑遵循 RULE 1 (artifacts/{appId}/public/data/rooms/{roomId})
      const roomDocRef = doc(db, 'artifacts', window.appState.appId, 'public', 'data', 'rooms', newRoomId);

      window.appState.unsubscribeDoc = onSnapshot(roomDocRef, (snapshot) => {
        if (snapshot.exists()) {
          const data = snapshot.data();
          window.appState.trips = data.trips || [];
        } else {
          // 若房間為空，寫入預設資料初始化
          window.appState.trips = DEFAULT_TRIPS;
          saveTripsToFirestore();
        }

        // 重新渲染畫面
        if (window.appState.currentTripId) {
          renderTripDetail();
        } else {
          renderDashboard();
        }
      }, (error) => {
        console.error("Firestore 監聽錯誤:", error);
      });
    }

    // 將資料同步至 Firestore
    async function saveTripsToFirestore() {
      if (!window.appState.user) return;
      try {
        const roomDocRef = doc(db, 'artifacts', window.appState.appId, 'public', 'data', 'rooms', window.appState.roomId);
        await setDoc(roomDocRef, {
          trips: window.appState.trips,
          updatedAt: new Date().toISOString()
        }, { merge: true });
      } catch (err) {
        console.error("儲存至雲端失敗:", err);
      }
    }

    // 導出共用函式至 window
    window.saveTripsToFirestore = saveTripsToFirestore;
    window.switchRoom = switchRoom;

    window.copyInviteLink = function() {
      const url = window.location.origin + window.location.pathname + '?room=' + window.appState.roomId;
      const dummy = document.createElement('input');
      document.body.appendChild(dummy);
      dummy.value = url;
      dummy.select();
      document.execCommand('copy');
      document.body.removeChild(dummy);
      alert('已複製實時共編邀請連結！發送給旅伴點開即可一起規劃。');
    };

    window.openRoomModal = function() {
      document.getElementById('inputRoomCode').value = window.appState.roomId;
      document.getElementById('roomModal').classList.remove('hidden');
    };

    window.closeRoomModal = function() {
      document.getElementById('roomModal').classList.add('hidden');
    };

    window.joinRoomFromInput = function() {
      const code = document.getElementById('inputRoomCode').value.trim().toUpperCase();
      if (!code) return;
      const newUrl = window.location.pathname + '?room=' + code;
      window.history.pushState({ path: newUrl }, '', newUrl);
      switchRoom(code);
      closeRoomModal();
    };

    window.createNewRandomRoom = function() {
      const newCode = 'TRIP' + Math.floor(1000 + Math.random() * 9000);
      document.getElementById('inputRoomCode').value = newCode;
      joinRoomFromInput();
    };

    window.openUserModal = function() {
      document.getElementById('inputUserName').value = window.appState.userName;
      document.getElementById('userModal').classList.remove('hidden');
    };

    window.closeUserModal = function() {
      document.getElementById('userModal').classList.add('hidden');
    };

    window.saveUserProfile = function() {
      const name = document.getElementById('inputUserName').value.trim();
      if (name) {
        window.appState.userName = name;
        localStorage.setItem('travel_user_name', name);
        updateUserDisplay();
      }
      closeUserModal();
    };

    function updateUserDisplay() {
      document.getElementById('displayUserName').textContent = window.appState.userName;
      document.getElementById('userAvatarDot').style.backgroundColor = window.appState.userColor;
    }

    function getRandomColor() {
      const colors = ['#0ea5e9', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#6366f1'];
      return colors[Math.floor(Math.random() * colors.length)];
    }

    // 啟動應用
    window.addEventListener('DOMContentLoaded', initFirebase);
  </script>

  <!-- UI 邏輯與介面互動 (全域) -->
  <script>
    // 切換頁面視圖
    function switchView(viewName) {
      const vDash = document.getElementById('viewDashboard');
      const vDetail = document.getElementById('viewTripDetail');

      if (viewName === 'dashboard') {
        vDash.classList.remove('hidden');
        vDetail.classList.add('hidden');
        window.appState.currentTripId = null;
        renderDashboard();
      } else {
        vDash.classList.add('hidden');
        vDetail.classList.remove('hidden');
        renderTripDetail();
      }
    }

    // 渲染 Dashboard 行程卡片
    function renderDashboard() {
      const grid = document.getElementById('tripListGrid');
      grid.innerHTML = '';
      const trips = window.appState.trips || [];

      if (trips.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full text-center py-12 bg-white rounded-2xl border border-dashed border-slate-300">
            <i class="fa-solid fa-map-location text-4xl text-slate-300 mb-3"></i>
