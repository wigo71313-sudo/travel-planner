      }

      trips.forEach(trip => {
        const daysCount = calculateDays(trip.startDate, trip.endDate);
        const spotsSpent = (trip.spots || []).reduce((sum, s) => sum + (Number(s.cost) || 0), 0);
        const flightsSpent = (trip.flights || []).reduce((sum, f) => sum + (Number(f.cost) || 0), 0);
        const totalSpent = spotsSpent + flightsSpent;
        const bgImg = trip.imageUrl || 'https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=800&q=80';

        const card = document.createElement('div');
        card.className = "bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-md transition cursor-pointer flex flex-col";
