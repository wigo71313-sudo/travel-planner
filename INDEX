    // 渲染預算分頁
    function renderBudgetOverview() {
      const trip = (window.appState.trips || []).find(t => t.id === window.appState.currentTripId);
      if (!trip) return;

      const totalBudget = Number(trip.budget) || 0;
      const spotsCost = (trip.spots || []).reduce((sum, s) => sum + (Number(s.cost) || 0), 0);
      const flightsCost = (trip.flights || []).reduce((sum, f) => sum + (Number(f.cost) || 0), 0);
      const totalSpent = spotsCost + flightsCost;
      const remaining = totalBudget - totalSpent;
      const percent = totalBudget > 0 ? Math.min(Math.round((totalSpent / totalBudget) * 100), 100) : 0;

      document.getElementById('budgetTotalDisplay').textContent = `$${totalBudget.toLocaleString()}`;
      document.getElementById('budgetSpentDisplay').textContent = `$${totalSpent.toLocaleString()}`;
      
      const remainElem = document.getElementById('budgetRemainDisplay');
      remainElem.textContent = `$${remaining.toLocaleString()}`;
      remainElem.className = remaining < 0 ? "text-2xl font-extrabold text-red-600 mt-1" : "text-2xl font-extrabold text-emerald-600 mt-1";

      document.getElementById('budgetPercentText').textContent = `${percent}%`;
      const pBar = document.getElementById('budgetProgressBar');
      pBar.style.width = `${percent}%`;
      pBar.className = percent > 90 ? "bg-red-500 h-full rounded-full transition-all duration-500" : "bg-brand-500 h-full rounded-full transition-all duration-500";

      const catTotals = {};
      (trip.spots || []).forEach(s => {
        const cat = s.category || '其他';
        catTotals[cat] = (catTotals[cat] || 0) + (Number(s.cost) || 0);
      });
      if (flightsCost > 0) {
        catTotals['交通'] = (catTotals['交通'] || 0) + flightsCost;
      }

      const catList = document.getElementById('budgetCategoriesList');
      catList.innerHTML = '';

      if (Object.keys(catTotals).length === 0) {
        catList.innerHTML = `<p class="text-xs text-slate-400 py-2">目前尚無任何花費數據</p>`;
        return;
      }

      Object.entries(catTotals).forEach(([cat, amount]) => {
        const catPercent = totalSpent > 0 ? Math.round((amount / totalSpent) * 100) : 0;
        const row = document.createElement('div');
        row.className = "space-y-1";
        row.innerHTML = `
          <div class="flex justify-between text-xs font-semibold text-slate-700">
            <span>${cat}</span>
            <span>$${amount.toLocaleString()} (${catPercent}%)</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
            <div class="bg-slate-700 h-full rounded-full" style="width: ${catPercent}%"></div>
          </div>
        `;
        catList.appendChild(row);
      });
    }

    // 渲染清單
    function renderChecklist() {
      const trip = (window.appState.trips || []).find(t => t.id === window.appState.currentTripId);
      if (!trip) return;

      const items = trip.checklist || [];
      const container = document.getElementById('checklistGroupContainer');
      container.innerHTML = '';

      const categories = ['證件檔案', '個人衣物', '3C電子', '藥品日常', '其他'];

      categories.forEach(cat => {
        const catItems = items.filter(i => i.category === cat);

        const card = document.createElement('div');
        card.className = "bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3";
        
        let itemsHtml = '';
        if (catItems.length === 0) {
          itemsHtml = `<p class="text-xs text-slate-300 py-2">尚未新增項目</p>`;
        } else {
          catItems.forEach(item => {
            itemsHtml += `
              <div class="flex items-center justify-between py-1.5 border-b border-slate-50">
                <label class="flex items-center space-x-2.5 cursor-pointer">
                  <input type="checkbox" ${item.checked ? 'checked' : ''} onchange="toggleCheckitem('${item.id}')" class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300">
                  <span class="text-xs font-medium ${item.checked ? 'line-through text-slate-400' : 'text-slate-700'}">${item.text}</span>
                </label>
                <button onclick="deleteCheckitem('${item.id}')" class="text-slate-300 hover:text-red-500 text-xs p-1">
                  <i class="fa-solid fa-xmark"></i>
                </button>
              </div>
            `;
          });
        }

        card.innerHTML = `
          <h4 class="font-bold text-slate-800 text-sm border-b border-slate-100 pb-2 flex items-center justify-between">
            <span>${cat}</span>
            <span class="text-xs font-normal text-slate-400">${catItems.filter(i=>i.checked).length}/${catItems.length}</span>
          </h4>
          <div class="space-y-1">
