    function switchTripTab(tabName) {
      const tabBtns = ['tabBtnItinerary', 'tabBtnFlights', 'tabBtnBudget', 'tabBtnChecklist'];
      const tabContents = ['tabContentItinerary', 'tabContentFlights', 'tabContentBudget', 'tabContentChecklist'];

      tabBtns.forEach(id => {
        document.getElementById(id).className = "py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-700 font-medium text-sm flex items-center whitespace-nowrap";
      });
      tabContents.forEach(id => document.getElementById(id).classList.add('hidden'));

      if (tabName === 'itinerary') {
        document.getElementById('tabBtnItinerary').className = "py-3 px-1 border-b-2 border-brand-600 text-brand-600 font-semibold text-sm flex items-center whitespace-nowrap";
        document.getElementById('tabContentItinerary').classList.remove('hidden');
      } else if (tabName === 'flights') {
        document.getElementById('tabBtnFlights').className = "py-3 px-1 border-b-2 border-brand-600 text-brand-600 font-semibold text-sm flex items-center whitespace-nowrap";
        document.getElementById('tabContentFlights').classList.remove('hidden');
        renderFlightsList();
      } else if (tabName === 'budget') {
        document.getElementById('tabBtnBudget').className = "py-3 px-1 border-b-2 border-brand-600 text-brand-600 font-semibold text-sm flex items-center whitespace-nowrap";
        document.getElementById('tabContentBudget').classList.remove('hidden');
        renderBudgetOverview();
      } else if (tabName === 'checklist') {
        document.getElementById('tabBtnChecklist').className = "py-3 px-1 border-b-2 border-brand-600 text-brand-600 font-semibold text-sm flex items-center whitespace-nowrap";
        document.getElementById('tabContentChecklist').classList.remove('hidden');
        renderChecklist();
      }
    }

    // --- 旅程 CRUD (雲端同步) ---
    function openNewTripModal() {
      window.appState.editingTripId = null;
      document.getElementById('tripModalTitle').textContent = '建立新旅程';
      document.getElementById('tripForm').reset();
      document.getElementById('tripModal').classList.remove('hidden');
    }

    function openEditTripModal() {
      const trip = (window.appState.trips || []).find(t => t.id === window.appState.currentTripId);
      if (!trip) return;
      window.appState.editingTripId = trip.id;
      document.getElementById('tripModalTitle').textContent = '編輯旅程';
      document.getElementById('inputTripTitle').value = trip.title;
      document.getElementById('inputTripStartDate').value = trip.startDate;
      document.getElementById('inputTripEndDate').value = trip.endDate;
      document.getElementById('inputTripBudget').value = trip.budget;
      document.getElementById('inputTripImage').value = trip.imageUrl || '';
      document.getElementById('tripModal').classList.remove('hidden');
    }

    function closeTripModal() {
      document.getElementById('tripModal').classList.add('hidden');
    }

    function handleSaveTrip(event) {
      event.preventDefault();
      const title = document.getElementById('inputTripTitle').value;
      const startDate = document.getElementById('inputTripStartDate').value;
      const endDate = document.getElementById('inputTripEndDate').value;
      const budget = Number(document.getElementById('inputTripBudget').value);
      const imageUrl = document.getElementById('inputTripImage').value;

      if (window.appState.editingTripId) {
        const trip = window.appState.trips.find(t => t.id === window.appState.editingTripId);
        if (trip) {
          trip.title = title;
          trip.startDate = startDate;
          trip.endDate = endDate;
          trip.budget = budget;
          trip.imageUrl = imageUrl;
        }
      } else {
        const newTrip = {
          id: 'trip_' + Date.now(),
          title,
          startDate,
          endDate,
          budget,
          imageUrl,
          spots: [],
          flights: [],
          checklist: [
            { id: 'c_' + Date.now() + '_1', category: '證件檔案', text: '身分證 / 護照', checked: false },
            { id: 'c_' + Date.now() + '_2', category: '3C電子', text: '手機充電線', checked: false }
          ]
        };
        window.appState.trips.push(newTrip);
        window.appState.currentTripId = newTrip.id;
      }

      window.saveTripsToFirestore();
      closeTripModal();

      if (window.appState.editingTripId) {
        renderTripDetail();
      } else {
        switchView('detail');
      }
    }

    function deleteCurrentTrip() {
      if (confirm('確定要刪除這個旅程嗎？此變更將同步至雲端。')) {
        window.appState.trips = window.appState.trips.filter(t => t.id !== window.appState.currentTripId);
        window.saveTripsToFirestore();
        switchView('dashboard');
      }
    }

    // --- 景點照片處理 & CRUD (雲端同步) ---
    function updateSpotImgPreview(url) {
      const box = document.getElementById('spotImgPreviewBox');
      const img = document.getElementById('spotImgPreview');
      if (url && url.trim()) {
        img.src = url;
        box.classList.remove('hidden');
      } else {
        box.classList.add('hidden');
        img.src = '';
      }
    }

    function presetSpotImage(url) {
      document.getElementById('inputSpotImage').value = url;
      updateSpotImgPreview(url);
    }

    function clearSpotImage() {
      document.getElementById('inputSpotImage').value = '';
      updateSpotImgPreview('');
    }

    function handleSpotPhotoUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const base64Url = e.target.result;
        document.getElementById('inputSpotImage').value = base64Url;
        updateSpotImgPreview(base64Url);
      };
      reader.readAsDataURL(file);
    }

    function openLightboxModal(imgUrl, caption) {
      document.getElementById('lightboxImage').src = imgUrl;
      document.getElementById('lightboxCaption').textContent = caption || '';
      document.getElementById('photoLightboxModal').classList.remove('hidden');
    }

    function closeLightboxModal() {
      document.getElementById('photoLightboxModal').classList.add('hidden');
    }

    function openAddSpotModal() {
      document.getElementById('spotModalTitle').textContent = '新增景點 / 活動';
      document.getElementById('spotForm').reset();
      document.getElementById('spotEditId').value = '';
      clearSpotImage();
      document.getElementById('spotModal').classList.remove('hidden');
    }

    function openEditSpotModal(spotId) {
      const trip = window.appState.trips.find(t => t.id === window.appState.currentTripId);
      if (!trip) return;
      const spot = (trip.spots || []).find(s => s.id === spotId);
      if (!spot) return;

      document.getElementById('spotModalTitle').textContent = '編輯景點 / 活動';
      document.getElementById('spotEditId').value = spot.id;
      document.getElementById('inputSpotTime').value = spot.time || '09:00';
      document.getElementById('inputSpotName').value = spot.name || '';
      document.getElementById('inputSpotCategory').value = spot.category || '景點';
      document.getElementById('inputSpotCost').value = spot.cost || 0;
      document.getElementById('inputSpotLocation').value = spot.location || '';
      document.getElementById('inputSpotImage').value = spot.image || '';
      document.getElementById('inputSpotUrl').value = spot.url || '';
      document.getElementById('inputSpotNotes').value = spot.notes || '';

      updateSpotImgPreview(spot.image);
      document.getElementById('spotModal').classList.remove('hidden');
    }

    function closeSpotModal() {
      document.getElementById('spotModal').classList.add('hidden');
    }

    function handleSaveSpot(event) {
      event.preventDefault();
      const trip = window.appState.trips.find(t => t.id === window.appState.currentTripId);
      if (!trip) return;

      const spotId = document.getElementById('spotEditId').value;
      const spotData = {
        time: document.getElementById('inputSpotTime').value,
        name: document.getElementById('inputSpotName').value,
        category: document.getElementById('inputSpotCategory').value,
        cost: Number(document.getElementById('inputSpotCost').value) || 0,
        location: document.getElementById('inputSpotLocation').value,
        image: document.getElementById('inputSpotImage').value,
        url: document.getElementById('inputSpotUrl').value,
        notes: document.getElementById('inputSpotNotes').value,
        updatedBy: window.appState.userName
      };

      if (!trip.spots) trip.spots = [];

      if (spotId) {
        const index = trip.spots.findIndex(s => s.id === spotId);
        if (index !== -1) {
          trip.spots[index] = { id: spotId, day: window.appState.currentSelectedDay, ...spotData };
        }
      } else {
        trip.spots.push({ id: 's_' + Date.now(), day: window.appState.currentSelectedDay, ...spotData });
      }

      window.saveTripsToFirestore();
      closeSpotModal();
      renderSpotsTimeline();
    }

    function deleteSpot(spotId) {
      const trip = window.appState.trips.find(t => t.id === window.appState.currentTripId);
      if (!trip) return;

      trip.spots = (trip.spots || []).filter(s => s.id !== spotId);
      window.saveTripsToFirestore();
      renderSpotsTimeline();
    }

    // --- 航班 CRUD ---
    function openAddFlightModal() {
      document.getElementById('flightModalTitle').textContent = '新增航班資訊';
      document.getElementById('flightForm').reset();
      document.getElementById('flightEditId').value = '';
      document.getElementById('flightModal').classList.remove('hidden');
    }

    function openEditFlightModal(flightId) {
      const trip = window.appState.trips.find(t => t.id === window.appState.currentTripId);
      if (!trip) return;
      const flight = (trip.flights || []).find(f => f.id === flightId);
      if (!flight) return;

      document.getElementById('flightModalTitle').textContent = '編輯航班資訊';
      document.getElementById('flightEditId').value = flight.id;
      document.getElementById('inputFlightType').value = flight.type || '去程';
      document.getElementById('inputFlightAirline').value = flight.airline || '';
      document.getElementById('inputFlightNo').value = flight.flightNo || '';
      document.getElementById('inputFlightPnr').value = flight.pnr || '';
      document.getElementById('inputFlightDepAirport').value = flight.depAirport || '';
      document.getElementById('inputFlightDepTime').value = flight.depTime || '';
      document.getElementById('inputFlightArrAirport').value = flight.arrAirport || '';
      document.getElementById('inputFlightArrTime').value = flight.arrTime || '';
      document.getElementById('inputFlightTerminal').value = flight.terminal || '';
      document.getElementById('inputFlightCost').value = flight.cost || 0;
      document.getElementById('inputFlightNotes').value = flight.notes || '';

      document.getElementById('flightModal').classList.remove('hidden');
    }

    function closeFlightModal() {
      document.getElementById('flightModal').classList.add('hidden');
    }

    function handleSaveFlight(event) {
      event.preventDefault();
      const trip = window.appState.trips.find(t => t.id === window.appState.currentTripId);
      if (!trip) return;

      const flightId = document.getElementById('flightEditId').value;
      const flightData = {
        type: document.getElementById('inputFlightType').value,
        airline: document.getElementById('inputFlightAirline').value,
        flightNo: document.getElementById('inputFlightNo').value,
        pnr: document.getElementById('inputFlightPnr').value,
        depAirport: document.getElementById('inputFlightDepAirport').value,
        depTime: document.getElementById('inputFlightDepTime').value,
        arrAirport: document.getElementById('inputFlightArrAirport').value,
        arrTime: document.getElementById('inputFlightArrTime').value,
        terminal: document.getElementById('inputFlightTerminal').value,
        cost: Number(document.getElementById('inputFlightCost').value) || 0,
        notes: document.getElementById('inputFlightNotes').value,
        updatedBy: window.appState.userName
      };

      if (!trip.flights) trip.flights = [];

      if (flightId) {
        const index = trip.flights.findIndex(f => f.id === flightId);
        if (index !== -1) {
          trip.flights[index] = { id: flightId, ...flightData };
        }
      } else {
        trip.flights.push({ id: 'f_' + Date.now(), ...flightData });
      }

      window.saveTripsToFirestore();
      closeFlightModal();
      renderFlightsList();
      renderBudgetOverview();
    }

    function deleteFlight(flightId) {
      const trip = window.appState.trips.find(t => t.id === window.appState.currentTripId);
      if (!trip) return;

      trip.flights = (trip.flights || []).filter(f => f.id !== flightId);
      window.saveTripsToFirestore();
      renderFlightsList();
      renderBudgetOverview();
    }

    function insertFlightToItinerary(flightId) {
      const trip = window.appState.trips.find(t => t.id === window.appState.currentTripId);
      if (!trip) return;
      const flight = (trip.flights || []).find(f => f.id === flightId);
      if (!flight) return;

      let targetDay = 1;
      if (flight.depTime && trip.startDate) {
        const depDate = new Date(flight.depTime.split('T')[0]);
        const startDate = new Date(trip.startDate);
        const diffDays = Math.ceil((depDate - startDate) / (1000 * 60 * 60 * 24)) + 1;
        if (diffDays > 0) targetDay = diffDays;
      }

      const timeStr = flight.depTime ? (flight.depTime.split('T')[1] || '08:00') : '08:00';

      if (!trip.spots) trip.spots = [];
      trip.spots.push({
        id: 's_' + Date.now(),
        day: targetDay,
        time: timeStr,
        name: `搭乘 ${flight.airline} (${flight.flightNo})`,
        category: '交通',
        cost: 0,
        location: flight.depAirport,
        image: 'https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=800&q=80',
        notes: `目的地: ${flight.arrAirport} | PNR: ${flight.pnr || '無'} | 航廈/門: ${flight.terminal || '未定'}`,
        updatedBy: window.appState.userName
      });

      window.saveTripsToFirestore();
      alert(`已成功將【${flight.airline} ${flight.flightNo}】加入第 ${targetDay} 天的每日行程中！`);
      switchTripTab('itinerary');
      window.appState.currentSelectedDay = targetDay;
      renderTripDetail();
    }

    // --- 打包清單 CRUD ---
    function addChecklistItem() {
      const textInput = document.getElementById('newCheckitemInput');
      const catSelect = document.getElementById('newCheckitemCat');
      const text = textInput.value.trim();
      const category = catSelect.value;

      if (!text) return;

      const trip = window.appState.trips.find(t => t.id === window.appState.currentTripId);
      if (!trip) return;

      if (!trip.checklist) trip.checklist = [];
      trip.checklist.push({
        id: 'c_' + Date.now(),
        category,
        text,
        checked: false
      });

      window.saveTripsToFirestore();
      textInput.value = '';
      renderChecklist();
    }

    function toggleCheckitem(itemId) {
      const trip = window.appState.trips.find(t => t.id === window.appState.currentTripId);
      if (!trip) return;

      const item = (trip.checklist || []).find(i => i.id === itemId);
      if (item) {
        item.checked = !item.checked;
        window.saveTripsToFirestore();
        renderChecklist();
      }
    }

    function deleteCheckitem(itemId) {
      const trip = window.appState.trips.find(t => t.id === window.appState.currentTripId);
      if (!trip) return;

      trip.checklist = (trip.checklist || []).filter(i => i.id !== itemId);
      window.saveTripsToFirestore();
      renderChecklist();
    }

    // 工具函式
    function calculateDays(startDate, endDate) {
      if (!startDate || !endDate) return 1;
      const start = new Date(startDate);
      const end = new Date(endDate);
      const diffTime = Math.abs(end - start);
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
      return diffDays > 0 ? diffDays : 1;
    }

    function getCategoryBadge(category) {
      switch (category) {
        case '景點': return `<span class="bg-blue-50 text-blue-600 text-xs font-medium px-2 py-0.5 rounded-md">景點 🎡</span>`;
        case '美食': return `<span class="bg-amber-50 text-amber-600 text-xs font-medium px-2 py-0.5 rounded-md">美食 🍱</span>`;
        case '交通': return `<span class="bg-purple-50 text-purple-600 text-xs font-medium px-2 py-0.5 rounded-md">交通 ✈️</span>`;
        case '住宿': return `<span class="bg-emerald-50 text-emerald-600 text-xs font-medium px-2 py-0.5 rounded-md">住宿 🏨</span>`;
        case '購物': return `<span class="bg-pink-50 text-pink-600 text-xs font-medium px-2 py-0.5 rounded-md">購物 🛍️</span>`;
        default: return `<span class="bg-slate-100 text-slate-600 text-xs font-medium px-2 py-0.5 rounded-md">其他 📌</span>`;
      }
    }
  </script>
