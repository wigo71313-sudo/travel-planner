<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>旅遊行程規劃器 | 雲端實時共編版</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'Noto Sans TC', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
            }
          }
        }
      }
    }
  </script>
  <style>
    /* 自訂滾動條 */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

  <!-- 頂部導覽列 -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
      <div class="flex items-center space-x-3 cursor-pointer" onclick="switchView('dashboard')">
        <div class="w-10 h-10 bg-brand-600 rounded-xl flex items-center justify-center text-white shadow-md">
          <i class="fa-solid fa-plane-departure text-xl"></i>
        </div>
        <div>
          <span class="font-extrabold text-xl text-slate-900 tracking-tight">TravelPlan</span>
          <span class="text-[10px] bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded-full ml-1 inline-flex items-center">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span>雲端即時共編
          </span>
        </div>
      </div>

      <!-- 房間與使用者狀態 -->
      <div class="flex items-center space-x-2 sm:space-x-3">
        <!-- 當前房間代碼顯示與邀請按鈕 -->
        <div class="hidden sm:flex items-center bg-slate-100 hover:bg-slate-200/80 rounded-xl px-3 py-1.5 border border-slate-200 transition">
          <i class="fa-solid fa-users text-brand-600 text-xs mr-2"></i>
          <span class="text-xs text-slate-500 mr-1">房間:</span>
          <span id="displayRoomCode" class="font-mono font-extrabold text-xs text-slate-800 mr-2">--</span>
          <button onclick="copyInviteLink()" title="複製邀請連結" class="text-xs text-brand-600 hover:text-brand-800 font-medium px-1.5 py-0.5 bg-white rounded border border-slate-200 shadow-2xs hover:bg-brand-50 transition">
            <i class="fa-solid fa-link mr-1"></i>邀請
          </button>
        </div>

        <!-- 使用者暱稱標籤 -->
        <button onclick="openUserModal()" class="flex items-center space-x-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-2.5 py-1.5 rounded-xl border border-slate-200 transition">
          <div id="userAvatarDot" class="w-3 h-3 rounded-full bg-brand-500"></div>
          <span id="displayUserName" class="font-semibold">訪客</span>
          <i class="fa-solid fa-pen text-[10px] text-slate-400"></i>
        </button>

        <button onclick="openRoomModal()" class="text-xs font-medium bg-slate-800 hover:bg-slate-900 text-white px-3 py-2 rounded-xl transition flex items-center">
          <i class="fa-solid fa-door-open mr-1.5"></i>切換房間
        </button>
        
        <button onclick="openNewTripModal()" class="bg-brand-600 hover:bg-brand-700 text-white text-xs font-medium px-3.5 py-2 rounded-xl shadow-sm transition flex items-center">
          <i class="fa-solid fa-plus mr-1"></i>建立行程
        </button>
      </div>
    </div>
  </header>

  <!-- 手機版房間號碼提示 -->
  <div class="sm:hidden bg-slate-800 text-white text-xs px-4 py-2 flex items-center justify-between">
    <div class="flex items-center space-x-2">
      <i class="fa-solid fa-users text-brand-400"></i>
      <span>目前房間：<strong id="displayRoomCodeMobile" class="font-mono text-brand-300">--</strong></span>
    </div>
    <button onclick="copyInviteLink()" class="bg-brand-600 hover:bg-brand-700 text-white px-2.5 py-1 rounded-lg text-[10px] font-semibold">
      <i class="fa-solid fa-share-nodes mr-1"></i>複製邀請連結
    </button>
  </div>

  <!-- 主要內容區 -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- 視圖 1：行程列表儀表板 -->
    <section id="viewDashboard" class="space-y-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
            我的旅程房間
            <span class="text-xs font-normal text-slate-500 bg-slate-200/60 px-2 py-0.5 rounded-md">Real-time Enabled</span>
          </h1>
          <p class="text-sm text-slate-500 mt-1">您在此房間中的變更將會透過雲端即時同步給所有成員</p>
        </div>
      </div>

      <div id="tripListGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- 動態渲染行程卡片 -->
      </div>
    </section>

    <!-- 視圖 2：行程詳細頁 -->
    <section id="viewTripDetail" class="hidden space-y-6">
      
      <!-- Banner 頂部看板 -->
      <div id="tripBanner" class="relative rounded-2xl overflow-hidden bg-slate-900 text-white p-6 sm:p-8 shadow-md">
        <div class="absolute inset-0 opacity-40 bg-cover bg-center" id="tripBannerBg"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/60 to-transparent"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div>
            <button onclick="switchView('dashboard')" class="text-xs bg-white/20 hover:bg-white/30 backdrop-blur-md text-white px-3 py-1.5 rounded-lg mb-3 inline-flex items-center transition">
              <i class="fa-solid fa-arrow-left mr-1"></i> 返回行程列表
            </button>
            <h2 id="detailTripTitle" class="text-3xl font-extrabold tracking-tight">--</h2>
            <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-200 mt-2">
              <span id="detailTripDates"><i class="fa-regular fa-calendar mr-1"></i> --</span>
              <span id="detailTripDays"><i class="fa-regular fa-clock mr-1"></i> -- 天</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button onclick="openEditTripModal()" class="bg-white/20 hover:bg-white/30 backdrop-blur-md text-white text-xs sm:text-sm px-3.5 py-2 rounded-xl transition flex items-center">
              <i class="fa-solid fa-pen-to-square mr-1.5"></i>編輯旅程
            </button>
            <button onclick="deleteCurrentTrip()" class="bg-red-500/80 hover:bg-red-600 text-white text-xs sm:text-sm px-3.5 py-2 rounded-xl transition flex items-center">
              <i class="fa-solid fa-trash mr-1.5"></i>刪除
            </button>
          </div>
        </div>
      </div>

      <!-- 分頁標籤 -->
      <div class="border-b border-slate-200 flex space-x-8 overflow-x-auto hide-scrollbar">
        <button id="tabBtnItinerary" onclick="switchTripTab('itinerary')" class="py-3 px-1 border-b-2 border-brand-600 text-brand-600 font-semibold text-sm flex items-center whitespace-nowrap">
          <i class="fa-solid fa-route mr-2"></i>每日行程 Timeline
        </button>
        <button id="tabBtnFlights" onclick="switchTripTab('flights')" class="py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-700 font-medium text-sm flex items-center whitespace-nowrap">
          <i class="fa-solid fa-plane mr-2"></i>航班資訊
        </button>
        <button id="tabBtnBudget" onclick="switchTripTab('budget')" class="py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-700 font-medium text-sm flex items-center whitespace-nowrap">
          <i class="fa-solid fa-wallet mr-2"></i>預算與費用
        </button>
        <button id="tabBtnChecklist" onclick="switchTripTab('checklist')" class="py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-700 font-medium text-sm flex items-center whitespace-nowrap">
          <i class="fa-solid fa-list-check mr-2"></i>打包清單
        </button>
      </div>

      <!-- Tab 1: 每日行程 -->
      <div id="tabContentItinerary" class="space-y-6">
        <div class="flex items-center space-x-2 overflow-x-auto pb-2 hide-scrollbar" id="dayTabsContainer">
          <!-- 動態生成天數按鈕 -->
        </div>

        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
          <div>
            <span id="currentDayTitle" class="font-bold text-slate-800 text-base">Day 1 行程規劃</span>
            <span id="currentDayCost" class="text-xs text-brand-600 font-semibold ml-2">當日小計: $0</span>
          </div>
          <button onclick="openAddSpotModal()" class="bg-brand-600 hover:bg-brand-700 text-white text-xs sm:text-sm font-medium px-4 py-2 rounded-xl transition flex items-center shadow-sm">
            <i class="fa-solid fa-plus mr-1.5"></i>新增活動景點
          </button>
        </div>

        <!-- 每日時間軸清單 -->
        <div id="spotsTimelineContainer" class="space-y-4">
          <!-- 動態渲染景點列表 -->
        </div>
      </div>

      <!-- Tab 2: 航班資訊 -->
      <div id="tabContentFlights" class="space-y-6 hidden">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
          <div>
            <h3 class="font-bold text-slate-800">航班與機票管理</h3>
            <p class="text-xs text-slate-500 mt-0.5">登記航班詳細資訊，可一鍵將起飛時間加入每日 Timeline</p>
          </div>
          <button onclick="openAddFlightModal()" class="bg-brand-600 hover:bg-brand-700 text-white text-xs sm:text-sm font-medium px-4 py-2 rounded-xl transition flex items-center shadow-sm whitespace-nowrap">
            <i class="fa-solid fa-plus mr-1.5"></i>新增航班資訊
          </button>
        </div>

        <div id="flightsContainer" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- 動態渲染航班卡片 -->
        </div>
      </div>

      <!-- Tab 3: 預算分析 -->
      <div id="tabContentBudget" class="hidden space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-xs font-medium text-slate-400">總預算 (Budget)</span>
            <div id="budgetTotalDisplay" class="text-2xl font-extrabold text-slate-800 mt-1">$0</div>
          </div>
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-xs font-medium text-slate-400">目前預計總開銷</span>
            <div id="budgetSpentDisplay" class="text-2xl font-extrabold text-brand-600 mt-1">$0</div>
          </div>
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-xs font-medium text-slate-400">剩餘額度 (Remaining)</span>
            <div id="budgetRemainDisplay" class="text-2xl font-extrabold text-emerald-600 mt-1">$0</div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3">
          <div class="flex justify-between items-center text-sm font-semibold">
            <span>預算已使用比例</span>
            <span id="budgetPercentText" class="text-brand-600">0%</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden">
            <div id="budgetProgressBar" class="bg-brand-500 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <h3 class="font-bold text-slate-800 mb-4 text-base">各分類費用統計 (含機票與景點)</h3>
          <div id="budgetCategoriesList" class="space-y-4">
            <!-- 動態渲染類別花費比例 -->
          </div>
        </div>
      </div>

      <!-- Tab 4: 打包清單 -->
      <div id="tabContentChecklist" class="space-y-6 hidden">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
          <div>
            <h3 class="font-bold text-slate-800">行李與行前準備清單</h3>
            <p class="text-xs text-slate-500 mt-0.5">點擊核取方塊標記已完成項目，將同步給所有成員</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <input type="text" id="newCheckitemInput" placeholder="新增物品 (如: 護照、藥品)" class="text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500 min-w-[160px]">
            <select id="newCheckitemCat" class="text-xs bg-slate-50 border border-slate-200 rounded-lg px-2 py-2 focus:outline-none">
              <option value="證件檔案">證件檔案</option>
              <option value="個人衣物">個人衣物</option>
              <option value="3C電子">3C電子</option>
              <option value="藥品日常">藥品日常</option>
              <option value="其他">其他</option>
            </select>
            <button onclick="addChecklistItem()" class="bg-brand-600 hover:bg-brand-700 text-white text-xs font-medium px-4 py-2 rounded-lg transition whitespace-nowrap">
              <i class="fa-solid fa-plus mr-1"></i>新增
            </button>
          </div>
        </div>

        <div id="checklistGroupContainer" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- 動態渲染清單組別 -->
        </div>
      </div>

    </section>
  </main>

  <!-- 頁腳 -->
  <footer class="bg-white border-t border-slate-200 py-6 mt-auto">
    <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-400">
      &copy; TravelPlan 智遊行 - Firebase 實時雲端共同編輯版
    </div>
  </footer>

  <!-- Modal 1: 建立/編輯旅程彈窗 -->
  <div id="tripModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
      <div class="flex justify-between items-center border-b border-slate-100 pb-3">
        <h3 id="tripModalTitle" class="font-bold text-lg text-slate-800">建立新旅程</h3>
        <button onclick="closeTripModal()" class="text-slate-400 hover:text-slate-600 text-lg"><i class="fa-solid fa-xmark"></i></button>
      </div>
      
      <form id="tripForm" onsubmit="handleSaveTrip(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">行程名稱 *</label>
          <input type="text" id="inputTripTitle" required placeholder="例如：東京 5 天 4 夜賞櫻之旅" class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">出發日期 *</label>
            <input type="date" id="inputTripStartDate" required class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">結束日期 *</label>
            <input type="date" id="inputTripEndDate" required class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">總預算 (TWD) *</label>
          <input type="number" id="inputTripBudget" required min="0" placeholder="例如: 50000" class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">封面圖片網址 (選填)</label>
          <input type="url" id="inputTripImage" placeholder="https://..." class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>

        <div class="flex justify-end space-x-2 pt-2">
          <button type="button" onclick="closeTripModal()" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-600 hover:bg-slate-100 transition">取消</button>
          <button type="submit" class="px-4 py-2 rounded-xl text-xs font-medium bg-brand-600 hover:bg-brand-700 text-white transition shadow-sm">儲存行程</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal 2: 新增/編輯景點活動彈窗 -->
  <div id="spotModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4 max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center border-b border-slate-100 pb-3">
        <h3 id="spotModalTitle" class="font-bold text-lg text-slate-800">新增景點 / 活動</h3>
        <button onclick="closeSpotModal()" class="text-slate-400 hover:text-slate-600 text-lg"><i class="fa-solid fa-xmark"></i></button>
      </div>
      
      <form id="spotForm" onsubmit="handleSaveSpot(event)" class="space-y-4">
        <input type="hidden" id="spotEditId">
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">時間 *</label>
            <input type="time" id="inputSpotTime" required class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">分類 *</label>
            <select id="inputSpotCategory" class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="景點">景點 🎡</option>
              <option value="美食">美食 🍱</option>
              <option value="交通">交通 ✈️</option>
              <option value="住宿">住宿 🏨</option>
              <option value="購物">購物 🛍️</option>
              <option value="其他">其他 📌</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">活動/景點名稱 *</label>
          <input type="text" id="inputSpotName" required placeholder="例如: 淺草寺 / 敘敘苑燒肉" class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">預計花費 (TWD)</label>
            <input type="number" id="inputSpotCost" min="0" value="0" class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">地點 / Google Map 關鍵字</label>
            <input type="text" id="inputSpotLocation" placeholder="例如: Sensō-ji" class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
        </div>

        <!-- 景點照片功能區 -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">景點照片 (Image URL 或 上傳檔案)</label>
          <div class="space-y-2">
            <input type="url" id="inputSpotImage" oninput="updateSpotImgPreview(this.value)" placeholder="貼上照片網址 https://..." class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
            
            <div class="flex items-center space-x-2 text-xs">
              <label class="cursor-pointer bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-3 py-1.5 rounded-lg transition inline-flex items-center">
                <i class="fa-solid fa-upload mr-1.5 text-brand-600"></i>上傳本地照片
                <input type="file" id="spotLocalImgInput" accept="image/*" onchange="handleSpotPhotoUpload(event)" class="hidden">
              </label>
              <span class="text-slate-400">或帶入範例圖：</span>
            </div>

            <!-- 快速精選照片 Preset -->
            <div class="flex space-x-2 pt-1 overflow-x-auto hide-scrollbar">
